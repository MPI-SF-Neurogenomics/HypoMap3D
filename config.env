# Path to initialize the root directory for all data stored 
DATADIR="/REDACTED-path/HypoMap3D-data/v0.9"

# Image paths
# Path to the uv r cuda image
UV_PATH="/REDACTED-path/HypoMap3D-data/containers/uv_r_cuda_0.2.1.sif"
# Path to CellRanger image
CELLRANGER_PATH="/REDACTED-path/HypoMap3D-data/containers/cellranger_9.0.0.sif"
# Path to Star solo image
STAR_PATH="/REDACTED-path/HypoMap3D-data/containers/STAR_2.7.11b.sif"
# Path for cellbender image
CELLBENDER_PATH="/REDACTED-path/HypoMap3D/Containers/cellbender_image.sif"

# Project-wide defaults for matplotlib plotting functions
MPLSTYLE="/REDACTED-path/HypoMap3D/resources/figures.mplstyle"

# SLURM variables. 
# Required if you intend to use SLURM for a subset of our scripts.
# SLURM email -> get emails for ending/failing SLURM jobs
SLURM_EMAIL="your.name@sf.mpg.de"
CPU_PARTITION="blade-c1"
GPU_PARTITION="falcon"
